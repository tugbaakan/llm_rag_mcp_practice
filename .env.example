# Kopyala: .env olarak kaydet ve gerçek anahtarı yapıştır.
OPENAI_API_KEY=

# İsteğe bağlı: lokal Qdrant (docker-compose.yml)
# QDRANT_URL=http://localhost:6333
# NAIVE_RAG_COLLECTION=naive_rag_pdf
# LangChain Qdrant koleksiyonu (stage3_langchain_rag.py — varsayılan langchain_rag_pdf)
# LANGCHAIN_RAG_COLLECTION=langchain_rag_pdf

# pgvector örneği (docker-compose postgres): aynı varsayılan stage2_pgvector.py içinde
# DATABASE_URL=postgresql://practice:practice@localhost:5433/vectordb
# Postgres web arayüzü (docker-compose adminer): http://localhost:8888
#   Sunucu alanına: postgres  (konteyner adı; DBeaver/pgAdmin'de localhost:5433)

# Pinecone (https://app.pinecone.io — ücretsiz serverless tier)
# PINECONE_API_KEY=
# İsteğe bağlı: PINECONE_INDEX=llm-rag-practice-demo  PINECONE_CLOUD=aws  PINECONE_REGION=us-east-1

# https://console.groq.com — ücretsiz tier
GROQ_API_KEY=
# İsteğe bağlı: tam model ID veya GROQ_BACKEND=mistral
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BACKEND=mistral
